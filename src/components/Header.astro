---
import { site } from '../data/site';
import { withBase } from '../lib/urls';
---
<header class="navbar mx-auto w-[calc(100%_-_2.5rem)] max-w-[1280px] px-0 py-6 md:w-[calc(100%_-_4rem)] md:py-[1.4rem]">
  <div class="navbar-start" aria-hidden="true"></div>
  <nav class="navbar-center gap-6 text-sm md:gap-8" aria-label="主导航">
    <a class="link link-hover" href={withBase()} aria-current={Astro.url.pathname === withBase() ? 'page' : undefined}>Home</a>
    <a class="link link-hover" href={withBase('blogs/')} aria-current={Astro.url.pathname === withBase('blogs/') ? 'page' : undefined}>Blogs</a>
  </nav>
  <div class="navbar-end">
    <a class="btn btn-ghost btn-circle" href={site.githubUrl} aria-label="访问 0x3a0 的 GitHub 主页" title="GitHub · 0x3a0">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 19 4.77 5.07 5.07 0 0 0 18.91 1S17.73.65 15 2.48a13.38 13.38 0 0 0-7 0C5.27.65 4.09 1 4.09 1A5.07 5.07 0 0 0 4 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 8 18.13V22" />
      </svg>
    </a>
  </div>
</header>
