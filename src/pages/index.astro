---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroWords from '../components/HeroWords.astro';
import ArticleList from '../components/ArticleList.astro';
import type { ArticlePreview } from '../data/article-previews';
import { postUrl } from '../lib/urls';
import { site } from '../data/site';
import { publishedPosts } from '../lib/posts';

const posts = (await publishedPosts()).slice(0, 5);
const articles: ArticlePreview[] = posts.map(({ id, data }) => ({
      id,
      title: data.title,
      description: data.description,
      pubDate: data.pubDate,
      category: data.category || '未分组',
      href: postUrl(id),
    }));
---
<BaseLayout title={site.title} description={site.description} home>
  <section class="hero border-base-300 py-8 md:py-18" aria-labelledby="intro-title">
    <div class="hero-content w-full max-w-none flex-col items-start gap-0 p-0 md:items-start">
      <div class="w-full min-w-0">
        <h1 id="intro-title" class="text-5xl font-normal">
          <span class="block">Hi, I'm Mingqing Teng.</span>
          <HeroWords words={site.heroWords} />
        </h1>
        <p class="my-2 max-w-[60rem] text-base leading-[1.7] text-muted">{site.description}</p>
        {site.links.length > 0 && <div class="flex flex-wrap gap-4 md:gap-4">{site.links.map(link => <a class="link link-hover" href={link.url}>{link.label} ↗</a>)}</div>}
      </div>
    </div>
  </section>
  <section aria-labelledby="latest-articles-title">
    {articles.length > 0 ? <ArticleList articles={articles} /> : <p class="py-12 text-base-content/60">还没有发布文章。</p>}
  </section>
</BaseLayout>
