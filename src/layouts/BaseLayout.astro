---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { withBase } from '../lib/urls';
interface Props { title: string; description: string; home?: boolean }
const { title, description, home = false } = Astro.props;
const pageTitle = title === site.title ? title : title + ' | ' + site.title;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
  </head>
  <body class="bg-background font-sans leading-[1.7] text-foreground [color-scheme:light] [overflow-wrap:anywhere] [&_a]:underline-offset-4 [&_a:hover]:text-accent [&_:focus-visible]:outline-2 [&_:focus-visible]:outline-accent [&_:focus-visible]:outline-offset-[5px] [&_code]:font-mono [&_pre]:font-mono [&_img]:h-auto [&_img]:max-w-full">
    <a class="absolute -top-40 left-4 z-20 bg-background px-4 py-2 focus:top-4" href="#main-content">跳到正文</a>
    <Header />
    <main id="main-content" class:list={['mx-auto min-h-[60vh] w-[calc(100%_-_2.5rem)] max-w-[1280px] pb-20 md:w-[calc(100%_-_4rem)]', home ? 'pt-0' : 'pt-8 md:pt-12']}><slot /></main>
    <Footer />
  </body>
</html>

