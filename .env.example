SITE_URL=https://0x3a0.github.io
SITE_BASE=/my-blog/

# Read-only Notion sync; real credentials stay in the local .env.
NOTION_TOKEN=
# Recommended: use the fixed article data source directly.
NOTION_DATA_SOURCE_ID=
# Optional with a data source ID; otherwise used to discover a single data source.
NOTION_DATABASE_ID=
